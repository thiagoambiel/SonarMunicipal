\@writefile{toc}{\contentsline {paragraph}{Avaliação anotada da recuperação.}{6}{paragraph*.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cobertura territorial da base final por UF. Estados em cinza não tiveram extração válida na execução congelada; a intensidade do azul indica o número de municípios cobertos em cada UF.\relax }}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:brazil-coverage-map}{{3}{7}{Cobertura territorial da base final por UF. Estados em cinza não tiveram extração válida na execução congelada; a intensidade do azul indica o número de municípios cobertos em cada UF.\relax }{figure.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Resumo agregado das métricas principais no benchmark anotado.\relax }}{7}{table.caption.7}\protected@file@percent }
\newlabel{tab:retrieval-eval-summary}{{1}{7}{Resumo agregado das métricas principais no benchmark anotado.\relax }{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Comparação de nDCG@10 por problema entre o baseline lexical BM25, a busca semântica por ementas e a busca semântica por ações textualizadas. Cada linha representa uma consulta, ordenada pela distância entre ações e BM25, do maior para o menor. A figura destaca que a vantagem média de ações é ampla, mas não uniforme, com perdas concentradas em consultas mais terminológicas.\relax }}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:retrieval-eval-problem}{{4}{8}{Comparação de nDCG@10 por problema entre o baseline lexical BM25, a busca semântica por ementas e a busca semântica por ações textualizadas. Cada linha representa uma consulta, ordenada pela distância entre ações e BM25, do maior para o menor. A figura destaca que a vantagem média de ações é ampla, mas não uniforme, com perdas concentradas em consultas mais terminológicas.\relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Delta relativo ao baseline lexical BM25, por problema e por métrica. O painel esquerdo mostra \textit  {ementas} $-$ BM25; o direito, \textit  {ações} $-$ BM25. Tons azuis indicam ganho e tons terracota indicam perda. O ponto a observar é que os ganhos de ações são mais frequentes e mais intensos nas métricas de ordenação e cobertura local, embora não se distribuam uniformemente entre todos os temas.\relax }}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:retrieval-eval-heatmap}{{5}{9}{Delta relativo ao baseline lexical BM25, por problema e por métrica. O painel esquerdo mostra \textit {ementas} $-$ BM25; o direito, \textit {ações} $-$ BM25. Tons azuis indicam ganho e tons terracota indicam perda. O ponto a observar é que os ganhos de ações são mais frequentes e mais intensos nas métricas de ordenação e cobertura local, embora não se distribuam uniformemente entre todos os temas.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Ganho médio por consulta com IC 95\% por \textit  {bootstrap} entre consultas para \textit  {ementas} e \textit  {ações} em relação ao baseline lexical BM25, além da contagem de vitórias, empates e derrotas por problema. A figura resume a comparação relativa no pool anotado e explicita a incerteza e a variabilidade entre problemas.\relax }}{10}{figure.caption.9}\protected@file@percent }
\newlabel{fig:retrieval-eval-summary}{{6}{10}{Ganho médio por consulta com IC 95\% por \textit {bootstrap} entre consultas para \textit {ementas} e \textit {ações} em relação ao baseline lexical BM25, além da contagem de vitórias, empates e derrotas por problema. A figura resume a comparação relativa no pool anotado e explicita a incerteza e a variabilidade entre problemas.\relax }{figure.caption.9}{}}
